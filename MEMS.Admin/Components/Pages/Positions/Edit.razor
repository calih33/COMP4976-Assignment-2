@page "/positions/{Id:int}/edit"
@attribute [Authorize]
@inject IPositionService Positions
@inject NavigationManager Nav

<PageTitle>Edit Position - MEMS Admin</PageTitle>

@if (_loaded && _model is null)
{
    <h1>Edit Position</h1>
    <p>Position not found.</p>
    <a class="btn btn-secondary" href="positions">Back</a>
}
else if (_model is not null)
{
    <h1>Edit @_model.Name</h1>

    @if (_errors.Count > 0)
    {
        <div class="alert alert-danger">
            <ul class="mb-0">
                @foreach (var error in _errors)
                {
                    <li>@error</li>
                }
            </ul>
        </div>
    }

    <EditForm Model="_model" OnValidSubmit="SaveAsync">
        <DataAnnotationsValidator />

        <div class="mb-3">
            <label class="form-label">Municipality</label>
            <input class="form-control" value="@_model.Municipality?.Name" disabled />
        </div>
        <div class="mb-3">
            <label class="form-label">Position</label>
            <InputText @bind-Value="_model.Name" class="form-control" />
            <ValidationMessage For="() => _model.Name" />
        </div>
        <div class="mb-3">
            <label class="form-label">Seats Available</label>
            <InputNumber @bind-Value="_model.SeatsAvailable" class="form-control" />
            <ValidationMessage For="() => _model.SeatsAvailable" />
        </div>

        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-secondary" href="positions">Cancel</a>
    </EditForm>
}

@code {
    [Parameter] public int Id { get; set; }

    private Position? _model;
    private bool _loaded;
    private List<string> _errors = new();

    protected override async Task OnParametersSetAsync()
    {
        _model = await Positions.GetAsync(Id);
        _loaded = true;
    }

    private async Task SaveAsync()
    {
        _errors.Clear();
        var result = await Positions.UpdateAsync(Id, _model!);
        if (result.Succeeded)
        {
            Nav.NavigateTo("positions");
            return;
        }

        _errors = result.Errors.SelectMany(kv => kv.Value).ToList();
        if (_errors.Count == 0)
        {
            _errors.Add("The position could not be saved.");
        }
    }
}
