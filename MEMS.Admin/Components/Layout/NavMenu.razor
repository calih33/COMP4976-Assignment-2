<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MEMS Admin</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="municipalities">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Municipalities
            </NavLink>
        </div>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="positions">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Positions
            </NavLink>
        </div>
    </nav>

    <AuthorizeView>
        <Authorized>
            <div class="nav-item px-3 mt-3 text-white-50 small">
                Signed in as @context.User.Identity?.Name
            </div>
            <div class="nav-item px-3">
                <form action="Identity/Account/Logout" method="post">
                    <AntiforgeryToken />
                    <button type="submit" class="nav-link btn btn-link text-start">Log out</button>
                </form>
            </div>
        </Authorized>
    </AuthorizeView>
</div>
